#include <stdio.h>

int main()
{
    int a[10], n, i, num, found = 0;

    printf("Enter the number of elements (maximum 10): ");
    scanf("%d", &n);

    if (n < 1 || n > 10)
    {
        printf("Invalid number of elements.");
        return 0;
    }

    printf("Enter the array elements:\n");

    for (i = 0; i < n; i++)
        scanf("%d", &a[i]);

    printf("Enter the value to search: ");
    scanf("%d", &num);

    for (i = 0; i < n; i++)
    {
        if (a[i] == num)
        {
            printf("Value found at position %d.\n", i + 1);
            found = 1;
            break;
        }
    }

    if (found == 0)
        printf("Value not found in the array.");

    return 0;
}
