#include <stdio.h>

int main()
{
    int a[10], b[10];
    int i, n;
    char ch;

    printf("Enter 10 elements:\n");

    for (i = 0; i < 10; i++)
        scanf("%d", &a[i]);

    printf("Enter number of positions to shift: ");
    scanf("%d", &n);

    printf("Enter L for left shift or R for right shift: ");
    scanf(" %c", &ch);

    if (n < 0 || n > 10)
    {
        printf("Invalid shift value.");
        return 0;
    }

    for (i = 0; i < 10; i++)
        b[i] = 0;

    if (ch == 'L' || ch == 'l')
    {
        for (i = 0; i < 10 - n; i++)
            b[i] = a[i + n];
    }
    else if (ch == 'R' || ch == 'r')
    {
        for (i = n; i < 10; i++)
            b[i] = a[i - n];
    }
    else
    {
        printf("Invalid direction.");
        return 0;
    }

    printf("Shifted array:\n");

    for (i = 0; i < 10; i++)
        printf("%d ", b[i]);

    return 0;
}
