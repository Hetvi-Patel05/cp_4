#include <stdio.h>

int main()
{
    int a[5], n, i, temp;

    printf("Enter the number of elements (maximum 5): ");
    scanf("%d", &n);

    if (n < 1 || n > 5)
    {
        printf("Invalid number of elements.");
        return 0;
    }

    printf("Enter the array elements:\n");

    for (i = 0; i < n; i++)
        scanf("%d", &a[i]);

    for (i = 0; i < n / 2; i++)
    {
        temp = a[i];
        a[i] = a[n - 1 - i];
        a[n - 1 - i] = temp;
    }

    printf("Reversed array:\n");

    for (i = 0; i < n; i++)
        printf("%d ", a[i]);

    return 0;
}
