#include <stdio.h>

int main()
{
    int a[10], n, i, num, pos;

    printf("Enter the number of elements (maximum 9): ");
    scanf("%d", &n);

    if (n < 0 || n >= 10)
    {
        printf("Invalid number of elements.");
        return 0;
    }

    printf("Enter the array elements:\n");

    for (i = 0; i < n; i++)
        scanf("%d", &a[i]);

    printf("Enter the number to insert: ");
    scanf("%d", &num);

    printf("Enter the position (1 to %d): ", n + 1);
    scanf("%d", &pos);

    if (pos < 1 || pos > n + 1)
    {
        printf("Invalid position.");
        return 0;
    }

    for (i = n; i >= pos; i--)
        a[i] = a[i - 1];

    a[pos - 1] = num;
    n++;

    printf("Array after insertion:\n");

    for (i = 0; i < n; i++)
        printf("%d ", a[i]);

    return 0;
}
