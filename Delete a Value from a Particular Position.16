#include <stdio.h>

int main()
{
    int a[10], n, i, pos;

    printf("Enter the number of elements: ");
    scanf("%d", &n);

    if (n < 1 || n > 10)
    {
        printf("Invalid number of elements.");
        return 0;
    }

    printf("Enter the array elements:\n");

    for (i = 0; i < n; i++)
        scanf("%d", &a[i]);

    printf("Enter the position to delete: ");
    scanf("%d", &pos);

    if (pos < 1 || pos > n)
    {
        printf("Invalid position.");
        return 0;
    }

    for (i = pos - 1; i < n - 1; i++)
        a[i] = a[i + 1];

    n--;

    printf("Array after deletion:\n");

    for (i = 0; i < n; i++)
        printf("%d ", a[i]);

    return 0;
}
